    "UI.Spread.greeting1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome! I'm your mystical guide through the world of Tarot. Ask your question."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მოგესალმებით! მე ვარ თქვენი მისტიკური გზამკვლევი ტაროს სამყაროში. დაუსვით თქვენი კითხვა."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добро пожаловать! Я — ваш мистический проводник в мир Таро. Задайте свой вопрос."
          }
        }
      }
    },
    "UI.Spread.greeting2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cards are ready. What question are you bringing today?"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბარათები მზად არის. რა კითხვა მოგაქვთ დღეს?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Карты готовы. Какой вопрос вы принесли сегодня?"
          }
        }
      }
    },
    "UI.Spread.greeting3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Greetings, Seeker. The cards await your question."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მოგესალმებით, მაძიებელო. ბარათები თქვენს კითხვას ელოდებიან."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приветствую, Искатель. Карты ждут вашего вопроса."
          }
        }
      }
    },
    "UI.Spread.greeting4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The mystical veil is thin today. Ask — and the cards will answer."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მისტიკური ფარდა დღეს თხელია. იკითხეთ — და ბარათები უპასუხებენ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мистическая завеса сегодня тонка. Спрашивайте — и карты ответят."
          }
        }
      }
    },
    "UI.Spread.newSpread": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alright, let's start over. Ask a new question — the cards are ready."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კარგი, თავიდან დავიწყოთ. დაუსვით ახალი კითხვა — ბარათები მზად არის."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хорошо, начнём заново. Задайте новый вопрос — карты готовы."
          }
        }
      }
    },
